%locations
%error-verbose
%{
    #include "TextHandler.hpp"

    extern int yylineno;
    extern char* yytext;
    extern YYLTYPE yylloc;
    extern int yylex();

    extern void yyerror(const char* message)
    {
        DumpRow();
        PrintError(message);
    }
%}
%defines

%start PROGRAM

%token IF ELSE WHILE DO FOR RETURN BREAK CONTINUE SWITCH CASE DEFAULT
%token EQ LE GE NE LEFT_SHIFT RIGHT_SHIFT
%token AND OR
%token TYPEDEF ENUM STRUCT UNION SIZEOF
%token PREPROCESSOR_DIRECTIVE
%token PREPROCESSOR_IF PREPROCESSOR_IFDEF PREPROCESSOR_IFNDEF
%token PREPROCESSOR_ELIF PREPROCESSOR_ELSE PREPROCESSOR_ENDIF
%token STRING CHARACTER_LITERAL INTEGER_LITERAL FLOAT_NUM ID PRINT ATTRIBUTE
%token CONST VOLATILE RESTRICT VOID
%token INT CHAR FLOAT DOUBLE SIZE_T BUILTIN_TYPE
%token GLOBAL LOCAL CONSTANT PRIVATE ACCESS_QUAL KERNEL
%token INCR DECR PLUS_IS MIN_IS MUL_IS DIV_IS AND_IS OR_IS MOD_IS XOR_IS
%token LEFT_IS RIGHT_IS
%token UNSIGNED LONG SHORT
%token ARROW
%token INVALID_FLOAT "invalid floating-point literal"
%token INVALID_STRING "invalid string literal"
%token INVALID_COMMENT "unterminated block comment"

%%

PROGRAM:
        /* empty */
|       TRANSLATION_UNIT
;

TRANSLATION_UNIT:
        EXTERNAL_DECLARATION
|       TRANSLATION_UNIT EXTERNAL_DECLARATION
;

EXTERNAL_DECLARATION:
        ';'
|       DECLARATION ';'
|       STRUCT_OR_UNION_DEFINITION ';'
|       ENUM_DEFINITION ';'
|       TYPEDEF_DECLARATION ';'
|       FUNCTION_DECLARATION
|       PREPROCESSOR_DIRECTIVE
|       NONFUNC_PREPROCESSOR_CONDITIONAL
;

PREPROCESSOR_IF_START:
        PREPROCESSOR_IF
|       PREPROCESSOR_IFDEF
|       PREPROCESSOR_IFNDEF
;

NONFUNC_PREPROCESSOR_CONDITIONAL:
        PREPROCESSOR_IF_START TRANSLATION_UNIT_OPTIONAL NONFUNC_PREPROCESSOR_TAIL
;

TRANSLATION_UNIT_OPTIONAL:
        /* empty */
|       TRANSLATION_UNIT
;

NONFUNC_PREPROCESSOR_TAIL:
        PREPROCESSOR_ENDIF
|       PREPROCESSOR_ELSE TRANSLATION_UNIT_OPTIONAL PREPROCESSOR_ENDIF
|       PREPROCESSOR_ELIF TRANSLATION_UNIT_OPTIONAL NONFUNC_PREPROCESSOR_TAIL
;

FUNC_PREPROCESSOR_CONDITIONAL:
        PREPROCESSOR_IF_START STATEMENT_LIST_OPTIONAL FUNC_PREPROCESSOR_TAIL
;

FUNC_PREPROCESSOR_TAIL:
        PREPROCESSOR_ENDIF
|       PREPROCESSOR_ELSE STATEMENT_LIST_OPTIONAL PREPROCESSOR_ENDIF
|       PREPROCESSOR_ELIF STATEMENT_LIST_OPTIONAL FUNC_PREPROCESSOR_TAIL
;

TYPE_QUALIFIER_OR_MODIFIER:
        CONST
|       VOLATILE
|       RESTRICT
|       UNSIGNED
|       LONG
|       SHORT
;

TYPE_QUALIFIER_SEQUENCE:
        TYPE_QUALIFIER_OR_MODIFIER
|       TYPE_QUALIFIER_SEQUENCE TYPE_QUALIFIER_OR_MODIFIER
;

TYPE_SPECIFIER:
        INT
|       CHAR
|       FLOAT
|       DOUBLE
|       VOID
|       SIZE_T
|       BUILTIN_TYPE
|       ID
;

CORE_DECLARATION_SPECIFIERS:
        TYPE_SPECIFIER
|       TYPE_QUALIFIER_SEQUENCE TYPE_SPECIFIER
|       TYPE_SPECIFIER TYPE_QUALIFIER_SEQUENCE
|       TYPE_QUALIFIER_SEQUENCE TYPE_SPECIFIER TYPE_QUALIFIER_SEQUENCE
;

ADDRESS_QUALIFIER:
        GLOBAL
|       LOCAL
|       CONSTANT
|       PRIVATE
;

DECLARATION_SPECIFIERS:
        CORE_DECLARATION_SPECIFIERS
|       ADDRESS_QUALIFIER CORE_DECLARATION_SPECIFIERS
|       ACCESS_QUAL CORE_DECLARATION_SPECIFIERS
|       ADDRESS_QUALIFIER ACCESS_QUAL CORE_DECLARATION_SPECIFIERS
|       ACCESS_QUAL ADDRESS_QUALIFIER CORE_DECLARATION_SPECIFIERS
;

TAGGED_TYPE_SPECIFIER:
        STRUCT ID
|       UNION ID
|       ENUM ID
;

CAST_TYPE_SPECIFIER:
        INT
|       CHAR
|       FLOAT
|       DOUBLE
|       VOID
|       SIZE_T
|       BUILTIN_TYPE
;

CAST_DECLARATION_SPECIFIERS:
        CAST_TYPE_SPECIFIER
|       TYPE_QUALIFIER_SEQUENCE
|       TYPE_QUALIFIER_SEQUENCE CAST_TYPE_SPECIFIER
|       CAST_TYPE_SPECIFIER TYPE_QUALIFIER_SEQUENCE
|       TYPE_QUALIFIER_SEQUENCE CAST_TYPE_SPECIFIER TYPE_QUALIFIER_SEQUENCE
|       ADDRESS_QUALIFIER CAST_TYPE_SPECIFIER
;

POINTER_OPTIONAL:
        /* empty */
|       POINTER
;

POINTER:
        '*'
|       '*' POINTER_QUALIFIER_SEQUENCE
|       POINTER '*'
|       POINTER '*' POINTER_QUALIFIER_SEQUENCE
;

POINTER_QUALIFIER_SEQUENCE:
        POINTER_QUALIFIER
|       POINTER_QUALIFIER_SEQUENCE POINTER_QUALIFIER
;

POINTER_QUALIFIER:
        CONST
|       VOLATILE
|       RESTRICT
;

ARRAY_SUFFIX_LIST_OPTIONAL:
        /* empty */
|       ARRAY_SUFFIX_LIST
;

ARRAY_SUFFIX_LIST:
        '[' EXPRESSION_OPTIONAL ']'
|       ARRAY_SUFFIX_LIST '[' EXPRESSION_OPTIONAL ']'
;

DECLARATOR:
        POINTER_OPTIONAL ID ARRAY_SUFFIX_LIST_OPTIONAL
;

INIT_DECLARATOR:
        DECLARATOR
|       DECLARATOR '=' INITIALIZER
;

INIT_DECLARATOR_LIST:
        INIT_DECLARATOR
|       INIT_DECLARATOR_LIST ',' INIT_DECLARATOR
;

INIT_DECLARATOR_LIST_OPTIONAL:
        /* empty */
|       INIT_DECLARATOR_LIST
;

DECLARATION:
        DECLARATION_SPECIFIERS INIT_DECLARATOR_LIST
;

TYPEDEF_DECLARATION:
        TYPEDEF DECLARATION
|       TYPEDEF STRUCT_OR_UNION_DEFINITION
|       TYPEDEF ENUM_DEFINITION
;

STRUCT_OR_UNION:
        STRUCT
|       UNION
;

STRUCT_OR_UNION_DEFINITION:
        STRUCT_OR_UNION '{' FIELD_DECLARATION_LIST_OPTIONAL '}'
            INIT_DECLARATOR_LIST_OPTIONAL
|       STRUCT_OR_UNION ID STRUCT_OR_UNION_AFTER_TAG
;

STRUCT_OR_UNION_AFTER_TAG:
        '{' FIELD_DECLARATION_LIST_OPTIONAL '}' INIT_DECLARATOR_LIST_OPTIONAL
|       INIT_DECLARATOR_LIST
|       /* forward declaration */
;

FIELD_DECLARATION_LIST_OPTIONAL:
        /* empty */
|       FIELD_DECLARATION_LIST
;

FIELD_DECLARATION_LIST:
        FIELD_DECLARATION
|       FIELD_DECLARATION_LIST FIELD_DECLARATION
;

FIELD_DECLARATION:
        DECLARATION ';'
|       STRUCT_OR_UNION_DEFINITION ';'
|       ENUM_DEFINITION ';'
;

ENUM_DEFINITION:
        ENUM '{' ENUMERATOR_LIST ENUMERATOR_COMMA_OPTIONAL '}'
            INIT_DECLARATOR_LIST_OPTIONAL
|       ENUM ID ENUM_AFTER_TAG
;

ENUM_AFTER_TAG:
        '{' ENUMERATOR_LIST ENUMERATOR_COMMA_OPTIONAL '}'
            INIT_DECLARATOR_LIST_OPTIONAL
|       INIT_DECLARATOR_LIST
;

ENUMERATOR_COMMA_OPTIONAL:
        /* empty */
|       ','
;

ENUMERATOR_LIST:
        ENUMERATOR
|       ENUMERATOR_LIST ',' ENUMERATOR
;

ENUMERATOR:
        ID
|       ID '=' ASSIGNMENT_EXPRESSION
;

INITIALIZER:
        ASSIGNMENT_EXPRESSION
|       '{' INITIALIZER_LIST_OPTIONAL '}'
;

INITIALIZER_LIST_OPTIONAL:
        /* empty */
|       INITIALIZER_LIST
|       INITIALIZER_LIST ','
;

INITIALIZER_LIST:
        INITIALIZER
|       INITIALIZER_LIST ',' INITIALIZER
;

ATTRIBUTE_SPECIFIER:
        ATTRIBUTE '(' '(' ATTRIBUTE_ITEM_LIST ')' ')'
;

ATTRIBUTE_ITEM_LIST:
        ATTRIBUTE_ITEM
|       ATTRIBUTE_ITEM_LIST ',' ATTRIBUTE_ITEM
;

ATTRIBUTE_ITEM:
        ID
|       ID '(' ATTRIBUTE_ARGUMENT_LIST_OPTIONAL ')'
;

ATTRIBUTE_ARGUMENT_LIST_OPTIONAL:
        /* empty */
|       ATTRIBUTE_ARGUMENT_LIST
;

ATTRIBUTE_ARGUMENT_LIST:
        ATTRIBUTE_ARGUMENT
|       ATTRIBUTE_ARGUMENT_LIST ',' ATTRIBUTE_ARGUMENT
;

ATTRIBUTE_ARGUMENT:
        ASSIGNMENT_EXPRESSION
|       CAST_TYPE_SPECIFIER
;

ATTRIBUTE_SPECIFIER_LIST:
        ATTRIBUTE_SPECIFIER
|       ATTRIBUTE_SPECIFIER_LIST ATTRIBUTE_SPECIFIER
;

FUNCTION_PREFIX:
        KERNEL
|       ATTRIBUTE_SPECIFIER_LIST
|       ATTRIBUTE_SPECIFIER_LIST KERNEL
|       KERNEL ATTRIBUTE_SPECIFIER_LIST
|       ATTRIBUTE_SPECIFIER_LIST KERNEL ATTRIBUTE_SPECIFIER_LIST
;

FUNCTION_ATTRIBUTE_LIST_OPTIONAL:
        /* empty */
|       ATTRIBUTE_SPECIFIER_LIST
;

FUNCTION_DECLARATION:
        DECLARATION_SPECIFIERS POINTER_OPTIONAL ID
            '(' PARAMETER_LIST_OPTIONAL ')' FUNCTION_ATTRIBUTE_LIST_OPTIONAL
            FUNCTION_END
|       FUNCTION_PREFIX DECLARATION_SPECIFIERS POINTER_OPTIONAL ID
            '(' PARAMETER_LIST_OPTIONAL ')' FUNCTION_ATTRIBUTE_LIST_OPTIONAL
            FUNCTION_END
;

FUNCTION_END:
        COMPOUND_STATEMENT
|       ';'
;

PARAMETER_LIST_OPTIONAL:
        /* empty */
|       PARAMETER_LIST
;

PARAMETER_LIST:
        PARAMETER_DECLARATION
|       PARAMETER_LIST ',' PARAMETER_DECLARATION
;

PARAMETER_DECLARATION:
        DECLARATION_SPECIFIERS
|       DECLARATION_SPECIFIERS DECLARATOR
;

COMPOUND_STATEMENT:
        '{' STATEMENT_LIST_OPTIONAL '}'
;

STATEMENT_LIST_OPTIONAL:
        /* empty */
|       STATEMENT_LIST
;

STATEMENT_LIST:
        STATEMENT
|       STATEMENT_LIST STATEMENT
;

STATEMENT:
        COMPOUND_STATEMENT
|       ';'
|       EXPRESSION ';'
|       DECLARATION ';'
|       STRUCT_OR_UNION_DEFINITION ';'
|       ENUM_DEFINITION ';'
|       TYPEDEF_DECLARATION ';'
|       IF_STATEMENT
|       SWITCH_STATEMENT
|       WHILE_STATEMENT
|       DO_WHILE_STATEMENT
|       FOR_STATEMENT
|       RETURN EXPRESSION_OPTIONAL ';'
|       BREAK ';'
|       CONTINUE ';'
|       CASE CONDITIONAL_EXPRESSION ':'
|       DEFAULT ':'
|       PREPROCESSOR_DIRECTIVE
|       FUNC_PREPROCESSOR_CONDITIONAL
;

IF_STATEMENT:
        IF '(' EXPRESSION ')' COMPOUND_STATEMENT
|       IF '(' EXPRESSION ')' COMPOUND_STATEMENT ELSE STATEMENT
;

SWITCH_STATEMENT:
        SWITCH '(' EXPRESSION ')' COMPOUND_STATEMENT
;

WHILE_STATEMENT:
        WHILE '(' EXPRESSION ')' STATEMENT
;

DO_WHILE_STATEMENT:
        DO STATEMENT WHILE '(' EXPRESSION ')' ';'
;

FOR_STATEMENT:
        FOR '(' FOR_INITIALIZER ';' EXPRESSION_OPTIONAL ';'
            EXPRESSION_OPTIONAL ')' STATEMENT
;

FOR_INITIALIZER:
        /* empty */
|       DECLARATION
|       EXPRESSION
;

EXPRESSION_OPTIONAL:
        /* empty */
|       EXPRESSION
;

EXPRESSION:
        ASSIGNMENT_EXPRESSION
|       EXPRESSION ',' ASSIGNMENT_EXPRESSION
;

ASSIGNMENT_EXPRESSION:
        CONDITIONAL_EXPRESSION
|       UNARY_EXPRESSION ASSIGNMENT_OPERATOR ASSIGNMENT_EXPRESSION
;

ASSIGNMENT_OPERATOR:
        '='
|       PLUS_IS
|       MIN_IS
|       MUL_IS
|       DIV_IS
|       MOD_IS
|       AND_IS
|       OR_IS
|       XOR_IS
|       LEFT_IS
|       RIGHT_IS
;

CONDITIONAL_EXPRESSION:
        LOGICAL_OR_EXPRESSION
|       LOGICAL_OR_EXPRESSION '?' EXPRESSION ':' CONDITIONAL_EXPRESSION
;

LOGICAL_OR_EXPRESSION:
        LOGICAL_AND_EXPRESSION
|       LOGICAL_OR_EXPRESSION OR LOGICAL_AND_EXPRESSION
;

LOGICAL_AND_EXPRESSION:
        INCLUSIVE_OR_EXPRESSION
|       LOGICAL_AND_EXPRESSION AND INCLUSIVE_OR_EXPRESSION
;

INCLUSIVE_OR_EXPRESSION:
        EXCLUSIVE_OR_EXPRESSION
|       INCLUSIVE_OR_EXPRESSION '|' EXCLUSIVE_OR_EXPRESSION
;

EXCLUSIVE_OR_EXPRESSION:
        AND_EXPRESSION
|       EXCLUSIVE_OR_EXPRESSION '^' AND_EXPRESSION
;

AND_EXPRESSION:
        EQUALITY_EXPRESSION
|       AND_EXPRESSION '&' EQUALITY_EXPRESSION
;

EQUALITY_EXPRESSION:
        RELATIONAL_EXPRESSION
|       EQUALITY_EXPRESSION EQ RELATIONAL_EXPRESSION
|       EQUALITY_EXPRESSION NE RELATIONAL_EXPRESSION
;

RELATIONAL_EXPRESSION:
        SHIFT_EXPRESSION
|       RELATIONAL_EXPRESSION '<' SHIFT_EXPRESSION
|       RELATIONAL_EXPRESSION '>' SHIFT_EXPRESSION
|       RELATIONAL_EXPRESSION LE SHIFT_EXPRESSION
|       RELATIONAL_EXPRESSION GE SHIFT_EXPRESSION
;

SHIFT_EXPRESSION:
        ADDITIVE_EXPRESSION
|       SHIFT_EXPRESSION LEFT_SHIFT ADDITIVE_EXPRESSION
|       SHIFT_EXPRESSION RIGHT_SHIFT ADDITIVE_EXPRESSION
;

ADDITIVE_EXPRESSION:
        MULTIPLICATIVE_EXPRESSION
|       ADDITIVE_EXPRESSION '+' MULTIPLICATIVE_EXPRESSION
|       ADDITIVE_EXPRESSION '-' MULTIPLICATIVE_EXPRESSION
;

MULTIPLICATIVE_EXPRESSION:
        CAST_EXPRESSION
|       MULTIPLICATIVE_EXPRESSION '*' CAST_EXPRESSION
|       MULTIPLICATIVE_EXPRESSION '/' CAST_EXPRESSION
|       MULTIPLICATIVE_EXPRESSION '%' CAST_EXPRESSION
;

CAST_EXPRESSION:
        UNARY_EXPRESSION
|       '(' CAST_DECLARATION_SPECIFIERS POINTER_OPTIONAL ')' CAST_EXPRESSION
|       '(' TAGGED_TYPE_SPECIFIER POINTER_OPTIONAL ')' CAST_EXPRESSION
;

UNARY_EXPRESSION:
        POSTFIX_EXPRESSION
|       INCR UNARY_EXPRESSION
|       DECR UNARY_EXPRESSION
|       UNARY_OPERATOR CAST_EXPRESSION
|       SIZEOF UNARY_EXPRESSION
|       SIZEOF '(' CAST_DECLARATION_SPECIFIERS POINTER_OPTIONAL ')'
|       SIZEOF '(' TAGGED_TYPE_SPECIFIER POINTER_OPTIONAL ')'
;

UNARY_OPERATOR:
        '&'
|       '*'
|       '+'
|       '-'
|       '~'
|       '!'
;

POSTFIX_EXPRESSION:
        PRIMARY_EXPRESSION
|       POSTFIX_EXPRESSION '[' EXPRESSION ']'
|       POSTFIX_EXPRESSION '(' ARGUMENT_EXPRESSION_LIST_OPTIONAL ')'
|       POSTFIX_EXPRESSION '.' ID
|       POSTFIX_EXPRESSION ARROW ID
|       POSTFIX_EXPRESSION INCR
|       POSTFIX_EXPRESSION DECR
;

PRIMARY_EXPRESSION:
        ID
|       PRINT
|       INTEGER_LITERAL
|       FLOAT_NUM
|       CHARACTER_LITERAL
|       STRING
|       '(' EXPRESSION ')'
;

ARGUMENT_EXPRESSION_LIST_OPTIONAL:
        /* empty */
|       ARGUMENT_EXPRESSION_LIST
;

ARGUMENT_EXPRESSION_LIST:
        ASSIGNMENT_EXPRESSION
|       ARGUMENT_EXPRESSION_LIST ',' ASSIGNMENT_EXPRESSION
;

%%
